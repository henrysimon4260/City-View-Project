{
  "name": "city-view-project",
  "private": true,
  "version": "0.1.0",
  "description": "Explore individual rental and condo units in a 3D downtown Manhattan map, with daylight and views factored in.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/write-study-footprints.mjs && node scripts/copy-decoders.mjs",
    "dev": "vite",
    "prebuild": "node scripts/write-study-footprints.mjs && node scripts/copy-decoders.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pretest": "node scripts/write-study-footprints.mjs",
    "test": "node scripts/check-floors.mjs && vitest run",
    "check-floors": "node scripts/check-floors.mjs",
    "compile-data": "node scripts/compile-data.mjs",
    "data": "node scripts/fetch-open-data.mjs && node scripts/compile-data.mjs",
    "feasibility": "node scripts/feasibility.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "3d-tiles-renderer": "^0.5.3",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.6",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.180.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
